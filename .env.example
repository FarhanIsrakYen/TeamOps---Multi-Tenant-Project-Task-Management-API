POSTGRES_DB=teamops
POSTGRES_USER=teamops
POSTGRES_PASSWORD=teamops
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m
DATABASE_HEALTH_CHECK_PERIOD=1m
DATABASE_STATEMENT_TIMEOUT=15s
DATABASE_LOCK_TIMEOUT=5s
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT=30s
JWT_SECRET=replace-with-at-least-32-characters
JWT_ISSUER=teamops-api
JWT_AUDIENCE=teamops-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
BCRYPT_COST=12
ORGANIZATION_CACHE_TTL=5m
PROJECT_CACHE_TTL=5m
RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT_PER_MIN=30
LOGIN_RATE_LIMIT_PER_MIN=10
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW=15m
REQUEST_BODY_MAX_BYTES=1048576
# Comma-separated proxy IPs or CIDRs. Leave empty unless requests pass through a trusted proxy.
TRUSTED_PROXIES=
CORS_ORIGINS=http://localhost:5173
# Browser-visible API URL served through frontend Nginx by default. This may
# also be an absolute URL when the API is hosted separately.
FRONTEND_API_BASE_URL=/api/v1
# Compile-time fallback for deployments that do not use the Nginx runtime config.
FRONTEND_BUILD_API_URL=/api/v1
JOB_QUEUE_SIZE=1024
JOB_WORKERS=4
JOB_MAX_RETRIES=3
JOB_INITIAL_BACKOFF=100ms
JOB_MAX_BACKOFF=5s
JOB_TIMEOUT=10s
STALE_TASK_AFTER=72h
STALE_TASK_SCAN_INTERVAL=15m
PROJECT_STATISTICS_REFRESH_INTERVAL=5m
SESSION_CLEANUP_INTERVAL=1h
# Leave empty to disable trace export. Example: http://otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_SERVICE_NAME=teamops-api
OTEL_TRACE_SAMPLE_RATIO=0.1
